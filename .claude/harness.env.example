# .claude/harness.env.example — template for the AI harness's shared project facts.
#
# Copy to `.claude/harness.env` and fill in (or run /harness-init). harness.env is gitignored;
# this .example is committed so every project starts from the same template.
#
# Holds ONLY the three simple scalars used directly in shell/git commands. All other project
# facts (repos, code paths, version-file path, quality gate) go in CLAUDE.local.md.

PROJECT_NAME=""             # Human-readable project name
TICKET_PREFIX=""            # Linear ticket prefix / team key (e.g. ABC → ABC-123)
DEFAULT_BRANCH="master"     # Protected release branch (master or main)
